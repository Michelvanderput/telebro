{
  "name": "telebro",
  "version": "0.1.0",
  "description": "Eigen mediabibliotheek op de Mac die direct naar je Sony Bravia streamt",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --mac dmg"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "castv2-client": "^1.2.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "nl.michel.telebro",
    "productName": "Telebro",
    "files": ["src/**/*", "package.json"],
    "asarUnpack": ["node_modules/ffmpeg-static/**", "node_modules/ffprobe-static/**"],
    "mac": { "category": "public.app-category.video", "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }] }
  }
}
